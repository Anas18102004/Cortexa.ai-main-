# Orbix Task Intelligence System - Environment Configuration

# ============================================================================
# AI PROVIDERS
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.0

# Alternative: Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://orbix:password@localhost:5432/orbix_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# REDIS (Caching & Queue)
# ============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT=development  # development | staging | production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# POLICY DEFAULTS
# ============================================================================

# Assignment Policy
DEFAULT_MIN_CONFIDENCE=0.8
DEFAULT_MAX_RISK=LOW
DEFAULT_AUTO_ASSIGN_ENABLED=true

# Capacity Policy
DEFAULT_MAX_UTILIZATION_PERCENT=85.0
DEFAULT_BUFFER_HOURS_PER_WEEK=8.0

# Escalation Policy
DEFAULT_ESCALATE_ON_HIGH_RISK=true
DEFAULT_LOW_CONFIDENCE_THRESHOLD=0.5

# Reasoning Policy
DEFAULT_MAX_REASONING_TIME_MS=900

# ============================================================================
# PERFORMANCE & MONITORING
# ============================================================================

# Performance SLAs (milliseconds)
SLA_INTENT_UNDERSTANDING_MS=100
SLA_MISSION_BUILDER_MS=50
SLA_DELIVERABLE_DECOMPOSITION_MS=200
SLA_ACTION_DECOMPOSITION_MS=200
SLA_ELIGIBILITY_FILTER_MS=50
SLA_CAPACITY_VECTOR_MS=100
SLA_REASONING_MS=900
SLA_POLICY_GATE_MS=50
SLA_EXECUTION_ROUTER_MS=100

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text

# ============================================================================
# SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys (for external integrations)
API_KEY_HEADER=X-API-Key

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_CREWAI_REASONING=true
ENABLE_CAPACITY_MARKET=true
ENABLE_AUTO_ASSIGNMENT=true
ENABLE_AUDIT_TRAIL=true

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Notification Service (for capacity market)
NOTIFICATION_SERVICE_URL=http://localhost:5000/api/notifications
NOTIFICATION_SERVICE_API_KEY=your_notification_api_key

# Document Service (for intent understanding)
DOCUMENT_SERVICE_URL=http://localhost:5001/api/documents
DOCUMENT_SERVICE_API_KEY=your_document_api_key

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Development
DEBUG=false
RELOAD=false

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://orbix:password@localhost:5432/orbix_test_db
